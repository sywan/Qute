# Copy to server/.env and adjust. All paths may use ~.
QUTE_ALLOWED_ORIGINS=https://sywan.github.io,http://localhost:5173,http://localhost:4173
QUTE_DEVICE=cuda            # cuda | mps | cpu
QUTE_MAX_SIDE=1024
# QUTE_MODELS_DIR=../public/models

# DCT-Net (ModelScope downloads weights automatically)
DCTNET_ENABLED=1

# VToonify: git clone https://github.com/williamyang1991/VToonify and download its checkpoints
# VTOONIFY_DIR=~/models/VToonify
# VTOONIFY_CKPT=checkpoint/vtoonify_d_cartoon/vtoonify_s_d.pt
# VTOONIFY_PYTHON=~/miniconda3/envs/vtoonify/bin/python
# VTOONIFY_STYLE_ID=26

# InstantID: git clone https://github.com/InstantID/InstantID ; python scripts/download_instantid.py
# INSTANTID_DIR=~/models/InstantID
# INSTANTID_CHECKPOINTS=~/models/InstantID/checkpoints
# INSIGHTFACE_ROOT=~/models/InstantID          # contains models/antelopev2
# INSTANTID_BASE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
# CHIBI_LORA=~/models/loras/chibi_sdxl.safetensors   # an SDXL chibi / blindbox LoRA you have rights to use
# CHIBI_LORA_SCALE=0.9
# INSTANTID_STEPS=30

# WarpGAN (TensorFlow 1.x environment): git clone https://github.com/seasonSH/WarpGAN
# WARPGAN_DIR=~/models/WarpGAN
# WARPGAN_MODEL=~/models/WarpGAN/pretrained/warpgan_pretrained
# WARPGAN_PYTHON=~/miniconda3/envs/warpgan/bin/python
# WARPGAN_CMD={python} test.py {model} {input} {output} --num_styles 1 --scale {scale}
