# Qute GPU server (Docker) settings. Copy to .env next to docker-compose.yml.
QUTE_PORT=8765
# Web origins allowed to call the server (add your own if you host Qute elsewhere)
QUTE_ALLOWED_ORIGINS=https://sywan.github.io,http://localhost:5173,http://localhost:4173
QUTE_MAX_SIDE=1024

# InstantID chibi
# Put your SDXL chibi / blind-box LoRA file in server/deploy/linux/loras/ and name it here:
CHIBI_LORA=/loras/chibi.safetensors
CHIBI_LORA_SCALE=0.9
INSTANTID_BASE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
INSTANTID_STEPS=30
INSTANTID_LCM=0              # 1 = LCM-LoRA, ~8 steps (faster, slightly softer)
INSTANTID_CPU_OFFLOAD=0      # 1 for GPUs with less than 16 GB VRAM
# CHIBI_PROMPT=chibi, super deformed, big head, small body, full body, cute, ...

# VToonify styles to download (cartoon, comic, arcane, pixar)
VTOONIFY_FETCH_STYLES=cartoon,comic,arcane,pixar
